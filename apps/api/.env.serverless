# ====================
# SERVERLESS DEPLOYMENT (Vercel + Supabase)
# ====================

# Server Configuration
NODE_ENV=production
PORT=3001

# Database - Supabase with Connection Pooling
# Use pgBouncer pooler for serverless functions (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection for migrations (port 5432)
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Configuration (Use strong secrets!)
JWT_SECRET=your-production-jwt-secret-at-least-64-chars-long-random-string
JWT_EXPIRES_IN=1d
JWT_ACCESS_SECRET=your-production-access-secret-minimum-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-production-refresh-secret-minimum-32-chars
JWT_REFRESH_EXPIRATION=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting (Adjusted for serverless)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS (Production URLs)
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# File Uploads (Use cloud storage for serverless)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/tmp/uploads

# Email (Production SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM="HMS SaaS <noreply@yourdomain.com>"

# Frontend URLs (Production)
FRONTEND_URL=https://your-frontend.vercel.app
RESET_PASSWORD_URL=https://your-frontend.vercel.app/reset-password

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Configuration
APP_NAME="HMS SaaS"
APP_VERSION=1.0.0
APP_URL=https://your-api.vercel.app

# Logging (Production)
LOG_LEVEL=error
LOG_TO_FILE=false

# API Documentation (Disable in production for security)
SWAGGER_ENABLED=false
SWAGGER_PATH=api-docs

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Vercel Detection
VERCEL=1

# Payment Gateways
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
